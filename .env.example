# ===== DATABASE =====
POSTGRES_USER=mardhotillah
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mardhotillah
# URL dipakai di dalam jaringan Docker (host: db). Untuk menjalankan API di luar Docker,
# ganti host menjadi localhost:5433
DATABASE_URL=postgresql://mardhotillah:change_me_strong_password@db:5432/mardhotillah?schema=public

# ===== API =====
JWT_SECRET=change_me_super_long_random_secret_min_32_chars
API_PUBLIC_URL=http://localhost:3102
PORT=3000

# ===== PUBLIC WEBSITE (apps/web) =====
NEXT_PUBLIC_API_URL=http://localhost:3102
API_INTERNAL_URL=http://api:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ===== CMS ADMIN (apps/admin) =====
# admin memakai NEXT_PUBLIC_API_URL yang sama (browser mengakses API langsung)

# ===== OBJECT STORAGE (opsional — media lokal disimpan di volume Docker) =====
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
